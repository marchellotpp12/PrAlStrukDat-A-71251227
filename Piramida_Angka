def pirmaida_angka(angka):
    
    for baris in range(1, angka + 1):
        for i in range(angka - baris):
            print("  ", end="")
            
        for i in range(1, baris + 1):
            if baris == 1 and i == baris:
                print(i, end="")
            else:
                print(i, end=" ")
                
        for i in range(baris - 1, 0, -1):
            if i == 1:
                print(i, end="")
            else:
                print(i, end=" ")
        print()

pirmaida_angka(3)